# ── LLM-провайдер ───────────────────────────────────────────────────────────
# Провайдер обирається цими трьома змінними, код чіпати не треба.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Модель ембедінгів для ChromaDB (Agentic RAG).
EMBEDDING_MODEL=text-embedding-3-small

# Локальний LM Studio — розкоментувати натомість
# (OPENAI_API_KEY тоді може бути будь-яким непорожнім рядком):
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=google/gemma-4-e4b
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ── Observability (Завд. 5) ─────────────────────────────────────────────────
# Langfuse Cloud — ключі з project settings на https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Альтернатива — LangSmith. Без ключів трейсинг просто вимкнено.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=hw3-mas-hr-screening
